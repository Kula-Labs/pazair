{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kula-Labs/pazair/main/a2a/schemas/evidence.schema.json",
  "title": "evidence (SPEC 17.4): one object per transfer that answers all five questions",
  "description": "Issued after the value arrived. Law 2: a settled payment without this object is an incident, not a feature; the gate refuses the next transfer on the chain until it exists. Everything it names is a hash of a signed object that anyone can fetch and check: identity, mandate, deal, receipt, policy.",
  "type": "object",
  "required": [
    "v",
    "kind",
    "issuer",
    "kid",
    "id",
    "transfer",
    "identity",
    "agent",
    "principal",
    "task",
    "deal",
    "mandate",
    "counterparty",
    "price",
    "settlement",
    "result",
    "gate",
    "issued_at",
    "sig"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "evidence"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "kid": {
      "$ref": "_defs.json#/$defs/kid"
    },
    "id": {
      "type": "string",
      "pattern": "^ev_"
    },
    "transfer": {
      "type": "string",
      "pattern": "^tr_"
    },
    "identity": {
      "$ref": "_defs.json#/$defs/sha256hex"
    },
    "agent": {
      "$ref": "_defs.json#/$defs/agent_id"
    },
    "principal": {
      "$ref": "_defs.json#/$defs/sha256hex"
    },
    "task": {
      "type": "object",
      "required": [
        "protocol",
        "task_id",
        "agreed_sha256"
      ],
      "properties": {
        "protocol": {
          "$ref": "_defs.json#/$defs/task_protocol"
        },
        "task_id": {
          "type": "string"
        },
        "agreed_sha256": {
          "$ref": "_defs.json#/$defs/sha256hex"
        }
      }
    },
    "deal": {
      "type": "object",
      "required": [
        "kind",
        "ref",
        "hash"
      ],
      "properties": {
        "kind": {
          "$ref": "_defs.json#/$defs/deal_kind"
        },
        "ref": {
          "type": "string"
        },
        "hash": {
          "$ref": "_defs.json#/$defs/sha256hex"
        },
        "order_ref": {
          "type": "string",
          "description": "The order id a UCP or ACP flow creates after payment, when one exists."
        }
      }
    },
    "mandate": {
      "$ref": "_defs.json#/$defs/sha256hex"
    },
    "counterparty": {
      "type": "object",
      "required": [
        "agent",
        "identity"
      ],
      "properties": {
        "agent": {
          "$ref": "_defs.json#/$defs/seller"
        },
        "identity": {
          "oneOf": [
            {
              "$ref": "_defs.json#/$defs/sha256hex"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "price": {
      "type": "object",
      "required": [
        "amount_minor",
        "currency"
      ],
      "properties": {
        "amount_minor": {
          "$ref": "_defs.json#/$defs/minor"
        },
        "currency": {
          "$ref": "_defs.json#/$defs/currency"
        }
      }
    },
    "settlement": {
      "type": "object",
      "required": [
        "rail",
        "id",
        "amount_minor",
        "currency",
        "fee_minor",
        "finality",
        "reversible_by_rail",
        "finalized_at"
      ],
      "properties": {
        "rail": {
          "$ref": "_defs.json#/$defs/rail"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The rail's own id: Stripe charge (ch_…), x402 or MPP payment reference, XRPL or Stellar transaction hash, SEPA end-to-end id."
        },
        "amount_minor": {
          "$ref": "_defs.json#/$defs/minor"
        },
        "currency": {
          "$ref": "_defs.json#/$defs/currency"
        },
        "fee_minor": {
          "$ref": "_defs.json#/$defs/minor"
        },
        "finalized_at": {
          "$ref": "_defs.json#/$defs/iso_time"
        },
        "finality": {
          "$ref": "_defs.json#/$defs/finality"
        },
        "reversible_by_rail": {
          "type": "boolean",
          "description": "true when the rail itself can still reverse it (a card chargeback). A reversal later is a dispute_decision with bears: rail, never a silent edit of this object."
        },
        "asset": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "fx": {
          "type": "object",
          "required": [
            "rate",
            "quoted_at"
          ],
          "properties": {
            "rate": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quoted_at": {
              "$ref": "_defs.json#/$defs/iso_time"
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "delivery_sha256",
        "receipt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "delivered",
            "not_delivered",
            "refunded",
            "disputed"
          ]
        },
        "delivery_sha256": {
          "oneOf": [
            {
              "$ref": "_defs.json#/$defs/sha256hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "_defs.json#/$defs/sha256hex"
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256hex(canonical(receipt)) of the SPEC 3 receipt, when one exists."
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "policy",
        "decision",
        "decided_at"
      ],
      "properties": {
        "policy": {
          "$ref": "_defs.json#/$defs/sha256hex"
        },
        "decision": {
          "const": "allow"
        },
        "decided_at": {
          "$ref": "_defs.json#/$defs/iso_time",
          "description": "Equals the transfer time (request.at) of the decision."
        }
      }
    },
    "issued_at": {
      "$ref": "_defs.json#/$defs/iso_time"
    },
    "sig": {
      "$ref": "_defs.json#/$defs/b64url"
    },
    "pq_sig": {
      "$ref": "_defs.json#/$defs/b64url"
    },
    "pq_kid": {
      "$ref": "_defs.json#/$defs/kid"
    }
  }
}
