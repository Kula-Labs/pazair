# Vercel AI Gateway key (https://vercel.com/docs/ai-gateway). On Vercel deployments this can be left empty: OIDC signs the requests.
AI_GATEWAY_API_KEY=
# Optional: the model, as provider/model through the AI Gateway.
PAZAIR_MODEL=anthropic/claude-haiku-5.5
# Optional: a PazAIr key of your own (register_agent). Without it the template registers a throwaway agent for the
# sandbox rehearsal on first use; by deploying you accept https://pazair.kulalabs.ch/terms for it. No money moves.
PAZAIR_API_KEY=
